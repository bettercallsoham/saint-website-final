# ===========================================
# SAInT Backend API - Environment Variables
# ===========================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/saint-db?retryWrites=true&w=majority&appName=Cluster0

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT secret key (use a strong, random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT expiration time (default: 7 days)
JWT_EXPIRE=7d

# Password reset token expiration (default: 10 minutes)
RESET_TOKEN_EXPIRE=10m

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# SMTP server settings for sending emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Email sender information
EMAIL_FROM_NAME=SAInT Team
EMAIL_FROM_EMAIL=noreply@saint-website.com

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
# Maximum file size in bytes (10MB = 10485760 bytes)
MAX_FILE_SIZE=10485760

# Upload directory path
UPLOAD_PATH=./uploads

# Allowed file types for gallery uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
# Rate limiting window in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000,https://your-frontend-domain.com

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging in development
ENABLE_REQUEST_LOGGING=true

# ===========================================
# API DOCUMENTATION
# ===========================================
# Enable Swagger documentation
ENABLE_SWAGGER=true

# API documentation title
API_TITLE=SAInT Backend API
API_VERSION=1.0.0
API_DESCRIPTION=Backend API for SAInT (Students Association in Technology) website

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Trust proxy (set to true when behind reverse proxy)
TRUST_PROXY=false

# Session secret for production
SESSION_SECRET=your-session-secret-key

# ===========================================
# MONITORING & HEALTH CHECKS
# ===========================================
# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# BACKUP & MAINTENANCE
# ===========================================
# Enable automatic backups
ENABLE_AUTO_BACKUP=false

# Backup interval in hours
BACKUP_INTERVAL_HOURS=24

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Enable detailed error messages in development
DETAILED_ERRORS=true

# Enable API request/response logging
ENABLE_API_LOGGING=true

# ===========================================
# NOTES
# ===========================================
# 1. Never commit .env file to version control
# 2. Use strong, unique values for all secrets
# 3. Update CORS_ORIGINS for production domains
# 4. Set NODE_ENV=production for production deployment
# 5. Use environment-specific MongoDB URIs
# 6. Configure proper email settings for production